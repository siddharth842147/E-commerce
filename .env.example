# ==============================================================================
# Kartiva E-Commerce - Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (Netlify / Cloudflare Pages / Vercel), set these variables in
# your hosting provider's Environment Variables dashboard.
#
# SECURITY NOTICE:
# Variables prefixed with NEXT_PUBLIC_ are bundled into client-side JavaScript.
# NEVER prefix server secrets (database credentials, API secrets, service keys)
# with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URL
# ------------------------------------------------------------------------------
# Full public URL of the application without trailing slash.
# Local: http://localhost:3000
# Production: https://kartiva.com (or your Netlify / Pages URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase (Auth, RLS, Storage)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anonymous key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# [SERVER-ONLY] Supabase service role key (bypasses RLS for storage & admin tasks)
# NEVER expose to client code or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (Supabase / Neon / Direct Postgres)
# ------------------------------------------------------------------------------
# Connection string used by Drizzle ORM.
# For serverless / edge environments, use the session/transaction pooler URL.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 4. Razorpay (Payment Gateway)
# ------------------------------------------------------------------------------
# Get your keys at https://dashboard.razorpay.com/app/keys
# Server-side API key ID
RAZORPAY_KEY_ID=rzp_test_yourKeyId
# [SERVER-ONLY] Razorpay Key Secret for order creation and verification
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# [SERVER-ONLY] Webhook secret for verifying HMAC-SHA256 signatures on /api/payments/webhook
# Create in Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 5. Session Management (Iron Session for Guest Carts)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] Secret key for signing cart cookies. Must be at least 32 characters.
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-secure-session-secret-at-least-32-chars-long

# ------------------------------------------------------------------------------
# 6. Resend (Transactional Email)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key
# Sender identity (e.g. "Kartiva <notifications@kartiva.com>" or "onboarding@resend.dev")
RESEND_FROM_EMAIL=Kartiva <notifications@kartiva.com>

# ------------------------------------------------------------------------------
# 7. MSG91 (SMS Notifications / OTP)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] MSG91 authentication key
MSG91_AUTH_KEY=your_msg91_auth_key
# Approved Sender ID (e.g. KARTIV)
MSG91_SENDER_ID=KARTIV
# DLT-approved template ID
MSG91_TEMPLATE_ID=your_msg91_template_id

# ------------------------------------------------------------------------------
# 8. WhatsApp Cloud API (Meta Graph API)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] System User Access Token from Meta Business Manager
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_token
# WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# WhatsApp Business Account ID (optional)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
# Webhook verification token (if handling incoming WhatsApp webhooks)
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token

# ------------------------------------------------------------------------------
# 9. Inngest (Durable Background Workflows)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] Inngest Event Key and Signing Key (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# ------------------------------------------------------------------------------
# 10. Shiprocket (Logistics & Shipping Fulfillment - Optional)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] Shiprocket API account credentials (uses mock/stub if empty)
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# ------------------------------------------------------------------------------
# 11. Cloudinary (Optional Asset CDN)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
